{
  "expo": {
    "name": "Sector",
    "slug": "sector",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sector",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.joewalla.sector",
      "supportsTablet": false
    },
    "android": {
      "package": "com.joewalla.sector"
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080B09",
          "image": "./assets/images/icon.png",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sector uses your location for route previews and to guide you during an active journey."
        }
      ],
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsVersion": "11.23.1"
        }
      ],
      [
        "@rnmapbox/navigation",
        {
          "locationWhenInUsePermission": "Sector uses your location for route previews and to guide you during an active journey."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "0ea48ea0-e62e-40c3-ba65-52afb2fc50ec"
      }
    }
  }
}
